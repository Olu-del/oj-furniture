generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                  Int         @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String      @unique(map: "User_email_key")
  password            String
  surveys             Survey[]
  createdAt           DateTime    @default(now())
  accountLocked       Boolean     @default(false)
  failedLoginAttempts Int         @default(0)
  resetCode           String?
  resetCodeExpiry     DateTime?
  role                UserRole    @default(USER)
  address             Address[]
  orders              Order[]
  cart                Cart?
  complaints          Complaint[]
}

model Address {
  id       Int     @id @default(autoincrement())
  userId   Int
  address  String?
  line1    String
  line2    String?
  city     String
  postcode String
  country  String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@index([userId], map: "Address_userId_fkey")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  total           Decimal     @db.Decimal(10, 2)
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryTotal   Decimal     @db.Decimal(10, 2)
  createdAt       DateTime    @default(now())
  surveys         Survey[]
  status          OrderStatus @default(PENDING)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Order_userId_fkey")
  orderItems      OrderItem[]
  shippingAddress String      @db.Text
  deliverySlot    String?
  deliveryDate    DateTime?
  deliveryStatus  String?
  complaints      Complaint[]

  @@index([userId], map: "Order_userId_fkey")
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int
  productId      Int
  quantity       Int
  price          Decimal @db.Decimal(10, 2)
  deliveryPrice  Decimal @db.Decimal(10, 2)
  deliverySlot   String?
  deliveryStatus String?
  name           String
  imageUrl       String
  order          Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], map: "OrderItem_productId_fkey")

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  subCategories SubCategory[]
  products      Product[]
}

model SubCategory {
  id         Int       @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@unique([name, categoryId])
}

model Product {
  id                  Int              @id @default(autoincrement())
  name                String
  description         String           @db.Text
  categoryId          Int
  subCategoryId       Int
  category            Category         @relation(fields: [categoryId], references: [id])
  subCategory         SubCategory      @relation(fields: [subCategoryId], references: [id])
  colour              String
  price               Decimal          @db.Decimal(10, 2)
  deliveryPrice       Decimal          @db.Decimal(10, 2)
  imageUrl            String
  images              ProductImage[]
  stock               Int              @default(0)
  orderItems          OrderItem[]
  cartItems           CartItem[]
  condition           ProductCondition
  age                 Int?
  dimensions          String?
  material            String?
  sustainabilityScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int        @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Complaint {
  id        Int      @id @default(autoincrement())
  type      String 
  message   String
  status    String   @default("OPEN")
  userId    Int
  orderId   Int
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  
}

model Survey {
  id        Int      @id @default(autoincrement())
  orderId   Int
  userId    Int
  rating    Int
  ease      Int
  comments  String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  @@unique([orderId, userId])
}


enum ProductCondition {
  NEW
  USED
  AS_GOOD_AS_NEW
  VERY_GOOD
  GOOD
  ACCEPTABLE
  DAMAGED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}
